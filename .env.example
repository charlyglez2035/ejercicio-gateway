PORT=3000
SESSION_SECRET=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=tu_password_de_postgres

# --- En la VM (monolito): llamadas internas, NO pasan por el gateway ---
BOOKS_SERVICE_URL=http://127.0.0.1:5001
LOGIN_SERVICE_URL=http://127.0.0.1:5000

# --- En tu PC/WSL (cliente Tkinter): todo via API Gateway nginx, puerto 80 ---
# Sustituye <VM_IP> por la IP externa actual de la VM (es efimera: cambia al reiniciarla).
# LOGIN_SERVICE_URL=http://<VM_IP>/api/login
# BOOKS_SERVICE_URL=http://<VM_IP>/api/books
USERS_SERVICE_URL=http://127.0.0.1:5002
AUTHORS_SERVICE_URL=http://127.0.0.1:5003
PEDIDOS_SERVICE_URL=http://127.0.0.1:5004
PAGOS_SERVICE_URL=http://127.0.0.1:5005
# USERS_SERVICE_URL=http://<VM_IP>/api/users
# AUTHORS_SERVICE_URL=http://<VM_IP>/api/authors
# PEDIDOS_SERVICE_URL=http://<VM_IP>/api/pedidos
# PAGOS_SERVICE_URL=http://<VM_IP>/api/pagos
SERVICE_TIMEOUT_SECONDS=10
